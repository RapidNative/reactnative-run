{
  "name": "rnrun",
  "version": "0.1.0",
  "type": "module",
  "description": "Drop-in replacement for the Expo dev server with a tiny memory footprint. Powered by browser-metro and pre-bundled packages from esm.reactnative.run.",
  "bin": {
    "rnrun": "./dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "expo",
    "react-native",
    "dev-server",
    "bundler",
    "metro",
    "hmr",
    "expo-go"
  ],
  "homepage": "https://reactnative.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RapidNative/reactnative-run.git"
  },
  "author": "Sanket Sahu <sanket@rapidnative.com> (https://github.com/sanketsahu)",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-async-generator-functions": "^7.29.7",
    "@babel/plugin-transform-async-to-generator": "^7.29.7",
    "@babel/plugin-transform-block-scoping": "^7.29.7",
    "@babel/plugin-transform-classes": "^7.29.7",
    "browser-metro": "^1.1.0",
    "chokidar": "^4.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
